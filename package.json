{
  "name": "grandstack-web",
  "version": "0.5.6",
  "description": "React client for grandstack-server with generated typed GraphQL operations",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "docs:check": "node scripts/check-links.mjs"
  },
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "graphql": "16.14.2",
    "motion": "14.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-force-graph-2d": "1.29.2",
    "react-router": "8.5.0",
    "urql": "5.0.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "puppeteer-core": "25.15.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "private": true
}
