{
  "name": "grandstack-web",
  "version": "0.1.0",
  "description": "React client for grandstack-server with generated typed GraphQL operations",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "graphql": "16.14.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "urql": "5.0.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "private": true
}
